{
  "manifest_version": 3,
  "name": "Mwijay Tech \u2014 Voice Studio & Local Vault",
  "short_name": "Mwijay Voice",
  "description": "Swahili-English voice dictation, read-aloud, and a device-local vault for saved snippets and secrets.",
  "version": "1.3.0",
  "author": "Davie Mwijay",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mwijay Tech Vault & Voice Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "commands": {
    "trigger-dictation": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Command+Shift+M"
      },
      "description": "Start voice dictation in focused input"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://techymwijay.vercel.app/*"
  ]
}
